{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coolify.local/contracts/execution/v1/remote-journal.schema.json",
  "title": "RemoteJournal",
  "type": "object",
  "required": [
    "protocol_version",
    "job_id",
    "operation_id",
    "attempt_id",
    "ownership_epoch",
    "resource_uuid",
    "input_fingerprint",
    "state",
    "boot_id",
    "updated_at"
  ],
  "properties": {
    "protocol_version": { "type": "string", "const": "v1" },
    "job_id": { "type": "string" },
    "operation_id": { "type": "string" },
    "attempt_id": { "type": "string" },
    "ownership_epoch": { "type": "integer", "minimum": 1 },
    "resource_uuid": { "type": "string" },
    "input_fingerprint": { "type": "string" },
    "state": { "type": "string", "enum": ["started", "running", "succeeded", "failed", "cancelled", "unknown"] },
    "boot_id": { "type": "string" },
    "pid": { "type": "integer" },
    "process_start_time": { "type": "string" },
    "container_ids": { "type": "array", "items": { "type": "string" } },
    "exit_code": { "type": ["integer", "null"] },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
