#!/usr/bin/env bash
# Manage the standalone Coolify stack (Astro + Vue 3.5 + Go 1.26 + Rust coolify-executor + PostgreSQL 16 + Redis 7).
#
# Usage:
#   ./scripts/dev [start]        # Start stack in background (auto-bootstraps DB + root user)
#   ./scripts/dev stop           # Stop containers (data is kept)
#   ./scripts/dev down|destroy   # Stop and remove containers (volumes are kept unless -v passed)
#   ./scripts/dev restart        # Restart stack containers
#   ./scripts/dev ps|status      # Show service status
#   ./scripts/dev logs [svc...]  # Follow logs
#   ./scripts/dev cli <args...>  # Run /usr/local/bin/coolify-cli inside controlplane
#
set -euo pipefail

cd "$(dirname "$0")/.."
COMPOSE_FILE="compose.yml"

usage() {
  sed -n '2,12p' "$0" | sed 's/^# \?//'
}

compose() {
  docker compose -f "$COMPOSE_FILE" "$@"
}

cmd="${1:-start}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$cmd" in
  --help | -h | help)
    usage
    ;;
  start | up)
    compose up -d --build "$@"
    app_url="${APP_URL:-http://localhost:${APP_PORT:-8000}}"
    root_email="${ROOT_USER_EMAIL:-admin@coolify.local}"
    root_pass="${ROOT_USER_PASSWORD:-CoolifyAdmin123!}"
    echo ""
    echo "Coolify Standalone is starting up!"
    echo "  URL:      ${app_url}"
    echo "  Email:    ${root_email}"
    echo "  Password: ${root_pass}"
    echo ""
    echo "Tip: Run './scripts/dev logs controlplane' to watch startup progress."
    ;;
  stop)
    compose stop "$@"
    ;;
  down | destroy)
    compose down --remove-orphans "$@"
    ;;
  restart)
    compose restart "$@"
    ;;
  ps | status)
    compose ps "$@"
    ;;
  logs)
    compose logs -f --tail=100 "$@"
    ;;
  cli)
    if [[ $# -eq 0 ]]; then
      compose exec controlplane /usr/local/bin/coolify-cli --help
    else
      compose exec controlplane /usr/local/bin/coolify-cli "$@"
    fi
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
