#!/usr/bin/env bash
# Manage the standalone Coolify stack (Astro + Vue 3.5 + Go 1.26 + Rust coolify-executor + PostgreSQL 16 + Redis 7).
#
# Usage:
#   ./scripts/dev [start]        # Start stack in background (auto-bootstraps DB + root user)
#   ./scripts/dev stop           # Stop containers (data is kept)
#   ./scripts/dev down|destroy   # Stop and remove containers (volumes are kept unless -v passed)
#   ./scripts/dev restart        # Restart stack containers
#   ./scripts/dev ps|status      # Show service status
#   ./scripts/dev logs [svc...]  # Follow logs
#   ./scripts/dev cli <args...>  # Run /usr/local/bin/coolify-cli inside controlplane
#   ./scripts/dev update|upgrade # Pull source and rebuild, stopping on Git errors
#   ./scripts/dev creds         # Show credentials saved by the installer
#
set -euo pipefail

cd "$(dirname "$0")/.."
COMPOSE_FILE="compose.yml"

usage() {
  cat <<'USAGE'
Goolify server management

Usage: sudo goolify <command> [service...]

  update             Pull the latest code and rebuild the stack
  status             Show containers and their status
  logs [service...]  Follow recent logs (for example: logs worker)
  restart [service...] Restart containers
  start              Start or rebuild the stack
  stop               Stop containers and keep their data
  down               Remove containers and keep volumes by default
  creds              Show the URL and initial login details saved by the installer
  cli [args...]      Run an administrative command
  help               Show this help

The upgrade command is an alias for update.
Installed commands work from any directory.

Examples:
  sudo goolify update
  sudo goolify logs worker
USAGE
}

compose() {
  docker compose -f "$COMPOSE_FILE" "$@"
}

cmd="${1:-start}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$cmd" in
  --help | -h | help)
    usage
    ;;
  update | upgrade)
    # Installer chmod changes must not block pulls; content edits still do.
    # This config applies only to this Git invocation, not the repository.
    git -c core.fileMode=false pull --ff-only
    compose up -d --build "$@"
    ;;
  creds | info)
    grep -E '^(APP_URL|ROOT_USER_EMAIL|ROOT_USER_PASSWORD)=' .env || true
    ;;
  start | up)
    compose up -d --build "$@"
    echo ""
    echo "Goolify containers started."
    echo "Installed server commands:"
    echo "  sudo goolify status             # Check service status"
    echo "  sudo goolify logs controlplane  # Follow startup logs"
    echo "  sudo goolify creds              # Show saved initial login details"
    echo ""
    ;;
  stop)
    compose stop "$@"
    ;;
  down | destroy)
    compose down --remove-orphans "$@"
    ;;
  restart)
    compose restart "$@"
    ;;
  ps | status)
    compose ps "$@"
    ;;
  logs)
    compose logs -f --tail=100 "$@"
    ;;
  cli)
    if [[ $# -eq 0 ]]; then
      compose exec controlplane /usr/local/bin/coolify-cli --help
    else
      compose exec controlplane /usr/local/bin/coolify-cli "$@"
    fi
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
