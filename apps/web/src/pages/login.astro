---
import '../styles/tokens.css';
import LoginPanel from '../features/auth/LoginPanel.vue';
import ThemeInit from '../components/ThemeInit.astro';
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | Goolify</title>
    <ThemeInit />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/goolify-logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <main class="auth-shell">
      <div class="auth-shell-content">
      <LoginPanel client:load />
      <p class="auth-attribution" data-testid="upstream-attribution">
        Goolify is an independent project based on{' '}
        <a href="https://github.com/coollabsio/coolify" target="_blank" rel="noopener noreferrer">Coolify</a>
        {' '}(Apache License 2.0).
      </p>
      </div>
    </main>
  </body>
</html>
