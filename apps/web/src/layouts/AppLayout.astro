---
import '../styles/tokens.css';
import '../styles/workspace.css';
import ThemeInit from '../components/ThemeInit.astro';
import SidebarNavigation from '../components/SidebarNavigation.vue';
import AccountMenu from '../components/AccountMenu.vue';
import GlobalSearch from '../components/GlobalSearch.vue';
import TeamAccess from '../features/teams/TeamAccess.vue';
import packageInfo from '../../package.json';
interface Props { title?: string }
const { title = 'Goolify' } = Astro.props;
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/goolify-logo.svg" type="image/svg+xml" />
    <ThemeInit />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="app-topbar" data-testid="app-topbar">
      <a class="app-brand" href="/" aria-label="Goolify dashboard"><img class="app-brand-mark" src="/goolify-logo.svg" alt="" width="20" height="20" /><span class="app-brand-label">Goolify</span><span class="app-version" title={packageInfo.version}>v{packageInfo.version}</span></a>
      <div class="app-topbar-content">
        <TeamAccess client:load />
        <span class="breadcrumb-divider" aria-hidden="true">/</span><span class="app-breadcrumb" data-page-label>Dashboard</span>
        <button class="chrome-button mobile-menu-toggle" type="button" data-testid="mobile-menu-toggle" aria-label="Open navigation menu" aria-haspopup="dialog" aria-controls="mobile-navigation"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg></button>
      </div>
    </header>
    <aside id="desktop-sidebar" class="app-sidebar" data-testid="app-sidebar">
      <SidebarNavigation client:load />
      <div class="sidebar-account-row"><AccountMenu client:load /><button class="chrome-button" type="button" data-testid="sidebar-collapse" aria-label="Collapse sidebar" aria-expanded="true" aria-controls="desktop-sidebar"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16" /></svg></button></div>
    </aside>
    <dialog id="mobile-navigation" class="mobile-navigation" data-testid="mobile-menu" aria-label="Navigation menu">
      <div class="mobile-navigation-heading"><strong>Goolify</strong><button class="chrome-button" type="button" data-close-navigation aria-label="Close navigation menu">✕</button></div>
      <SidebarNavigation mobile client:load />
      <div class="sidebar-account-row"><AccountMenu client:load /></div>
    </dialog>
    <main id="main-content" class="app-main" tabindex="-1"><slot /></main>
    <GlobalSearch client:load />
    <p class="sr-only" data-testid="upstream-attribution">Goolify is based on Coolify by Andras Bacsai and the CoolLabs community.</p>
    <script>
      const root = document.documentElement;
      const collapse = document.querySelector<HTMLButtonElement>('[data-testid="sidebar-collapse"]');
      const drawer = document.querySelector<HTMLDialogElement>('#mobile-navigation');
      function syncCollapse() {
        const expanded = root.dataset.sidebarCollapsed !== 'true';
        collapse?.setAttribute('aria-expanded', String(expanded));
        collapse?.setAttribute('aria-label', expanded ? 'Collapse sidebar' : 'Expand sidebar');
      }
      collapse?.addEventListener('click', () => {
        root.dataset.sidebarCollapsed = String(root.dataset.sidebarCollapsed !== 'true');
        try { localStorage.setItem('sidebarCollapsed', root.dataset.sidebarCollapsed); } catch { /* Browser storage is optional. */ }
        syncCollapse();
      });
      document.querySelector('[data-testid="mobile-menu-toggle"]')?.addEventListener('click', () => drawer?.showModal());
      document.querySelector('[data-close-navigation]')?.addEventListener('click', () => drawer?.close());
      drawer?.addEventListener('click', event => { const rect = drawer.getBoundingClientRect(); if (event.target === drawer && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) drawer.close(); });
      window.addEventListener('open-global-search', () => drawer?.close());
      window.addEventListener('open-help-feedback', () => drawer?.close());
      const path = location.pathname;
      const label = path === '/' ? 'Dashboard' : path.startsWith('/project') ? 'Projects' : path.startsWith('/server') ? 'Servers' : path.split('/').filter(Boolean).map(part => part.replaceAll('-', ' ')).slice(0, 2).join(' / ');
      const breadcrumb = document.querySelector('[data-page-label]');
      if (breadcrumb) breadcrumb.textContent = label.charAt(0).toUpperCase() + label.slice(1);
      syncCollapse();
    </script>
  </body>
</html>
